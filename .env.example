ENVIRONMENT=local
POSTGRES_DB=saxpath
POSTGRES_USER=saxpath
POSTGRES_PASSWORD=saxpath
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Use postgres for beta/private-release verification.
PERSISTENCE_BACKEND=postgres
DEMO_LEARNER_ID=demo
# Keep demo mode disabled for V1/private beta runs.
DEMO_MODE=false
RECORDING_STORAGE_DIR=/app/data/recordings
AUDIO_ENGINE_BASE_URL=http://audio-engine:8010
API_HOST=0.0.0.0
API_PORT=8000
# Replace these origins with the real beta URL before inviting learners.
CORS_ALLOW_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:3001","http://localhost:3001","http://127.0.0.1:4130","http://localhost:4130"]
